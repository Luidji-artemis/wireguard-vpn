# Exemple de configuration client WireGuard
# Remplacer chaque valeur entre chevrons. Ne jamais publier la vraie cle.
[Interface]
PrivateKey = <CLE_PRIVEE_CLIENT1>
Address = 10.8.0.2/24
DNS = 1.1.1.1

[Peer]
PublicKey = <CLE_PUBLIQUE_SERVEUR>
Endpoint = <IP_SERVEUR>:51820
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
